{
  "name": "polyplaces-frontend",
  "private": true,
  "scripts": {
    "bust": "node scripts/bust-cache.js",
    "snapshot": "node scripts/snapshot-products.js",
    "preserve": "node scripts/generate-env.js && node scripts/snapshot-products.js && node scripts/build-frames.js && node scripts/build-preview.js && node scripts/bust-cache.js",
    "serve": "serve -l 3000 .",
    "build:preview": "node scripts/build-preview.js",
    "build:frames": "node scripts/build-frames.js",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@mapbox/vector-tile": "^3.0.0",
    "@playwright/test": "^1.64.1",
    "earcut": "^3.2.4",
    "esbuild": "^0.28.2",
    "leaflet": "1.9.4",
    "pbf": "^5.1.2",
    "pmtiles": "^4.5.0",
    "polygon-clipping": "^0.15.7",
    "serve": "^14.2.1",
    "three": "^0.186.1",
    "vitest": "^5.0.5"
  }
}
